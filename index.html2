<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>坑BTI · KBTI</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;700;900&family=Fredoka:wght@600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f5f0eb;--card:#fff;--bdr:#e8e0d6;--gold:#d4a020;--blue:#3b9cf0;--red:#f05050;--purple:#9060e0;--green:#30b070;--pink:#e060a0;--txt:#3a3530;--txt2:#6a6560;--dim:#b0a89e;--accent:#ff6b40}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{background:var(--bg);color:var(--txt);font-family:'Noto Sans SC',sans-serif;overflow-x:hidden;min-height:100dvh;font-size:16px}
.screen{display:none;min-height:100dvh;flex-direction:column}.screen.active{display:flex}
.intro{align-items:center;justify-content:center;text-align:center;padding:2.5rem 1.5rem;position:relative;overflow:hidden;background:linear-gradient(145deg,#fef9f0 0%,#f0e8f8 50%,#e8f4f0 100%)}
.intro::before{content:'? ! @ # $ %';position:absolute;font-size:8rem;font-weight:900;color:rgba(0,0,0,.02);white-space:nowrap;animation:marquee 15s linear infinite;top:20%}
.intro::after{content:'GG FF TILT AFK GANK';position:absolute;font-size:6rem;font-weight:900;color:rgba(0,0,0,.02);white-space:nowrap;animation:marquee 20s linear infinite reverse;bottom:15%}
@keyframes marquee{from{transform:translateX(100%)}to{transform:translateX(-200%)}}
.intro>*{position:relative;z-index:1}
.intro .badge{display:inline-block;padding:5px 14px;background:var(--accent);color:#fff;border-radius:20px;font-size:.75rem;font-weight:700;letter-spacing:1px;margin-bottom:1.2rem;transform:rotate(-2deg)}
.intro h1{font-family:'Fredoka','Noto Sans SC',sans-serif;font-size:3.2rem;font-weight:700;color:var(--txt);line-height:1}
.intro h1 .k{color:var(--accent)}
.intro .sub-en{font-family:'Fredoka',sans-serif;font-size:.85rem;color:var(--dim);letter-spacing:1px;margin-bottom:1.8rem}
.intro .pitch{font-size:1rem;color:var(--txt2);line-height:2;max-width:340px;margin-bottom:2rem}
.intro .pitch b{color:var(--txt);font-weight:900}
.btn{display:inline-flex;align-items:center;justify-content:center;padding:1rem 2.5rem;border:none;border-radius:50px;background:var(--accent);color:#fff;font-size:1.05rem;font-weight:900;font-family:inherit;cursor:pointer;letter-spacing:2px;transition:all .2s;box-shadow:0 4px 15px rgba(255,107,64,.3)}
.btn:active{transform:scale(.95);box-shadow:0 2px 8px rgba(255,107,64,.2)}
.intro .warn{font-size:.72rem;color:var(--dim);margin-top:1.5rem;line-height:1.7}
.intro .disclaimer{font-size:.66rem;color:var(--dim);opacity:.7;margin-top:1.2rem;line-height:1.6;padding:0 .5rem;text-align:center;max-width:340px}
.r-disclaimer{display:inline-block;margin-top:.6rem;font-size:.64rem;opacity:.75;line-height:1.6}
.quiz{padding:0 0 2rem;background:var(--bg)}
.q-progress{position:sticky;top:0;z-index:10;background:var(--bg);padding:.8rem 1.2rem .6rem}
.q-bar-wrap{height:6px;background:#e0d8d0;border-radius:3px;overflow:hidden;margin-bottom:.4rem}
.q-bar{height:100%;background:linear-gradient(90deg,var(--accent),var(--pink),var(--purple));border-radius:3px;transition:width .4s}
.q-info{display:flex;justify-content:space-between;font-size:.78rem;color:var(--dim)}
.q-card{padding:1.2rem 1.2rem 0;animation:fadeUp .28s ease}
@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
.q-num{font-family:'Fredoka',sans-serif;font-size:.72rem;color:var(--dim);letter-spacing:2px;margin-bottom:.4rem}
.q-text{font-size:1.05rem;color:var(--txt);line-height:1.75;margin-bottom:1.2rem;font-weight:700}
.q-opts{display:flex;flex-direction:column;gap:.6rem}
.q-opt{display:flex;align-items:flex-start;gap:.7rem;padding:.9rem 1rem;border:2px solid transparent;border-radius:12px;background:var(--card);cursor:pointer;transition:all .18s;user-select:none;box-shadow:0 1px 3px rgba(0,0,0,.04)}
.q-opt:active{transform:scale(.98)}
.q-opt.sel{border-color:var(--accent);background:#fff5f0;box-shadow:0 2px 8px rgba(255,107,64,.12)}
.q-opt .dot{width:20px;height:20px;border:2px solid #d0c8c0;border-radius:50%;flex-shrink:0;margin-top:2px;transition:all .18s}
.q-opt.sel .dot{border-color:var(--accent);background:var(--accent);box-shadow:0 0 0 3px rgba(255,107,64,.15)}
.q-opt span{font-size:.95rem;line-height:1.55;color:var(--txt2)}.q-opt.sel span{color:var(--txt);font-weight:700}
.q-nav{padding:.8rem 1.2rem;display:flex;gap:.6rem}
.q-nav .btn{flex:1;padding:.75rem;font-size:.9rem;letter-spacing:1px;border-radius:12px}
.btn-prev{background:#e8e0d8;color:var(--txt2);box-shadow:none}.btn-next{background:var(--accent)}.btn-submit{background:var(--purple);box-shadow:0 4px 12px rgba(144,96,224,.3)}
.result{padding:0 1rem 3rem;background:linear-gradient(180deg,#f8f4ff 0%,var(--bg) 30%)}
.r-hero{text-align:center;padding:2rem 0 1rem}
.r-img{width:160px;height:160px;border-radius:24px;background:var(--card);border:3px solid var(--bdr);margin:0 auto 1rem;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,.08)}
.r-img img{width:100%;height:100%;object-fit:cover}
.r-logo2{font-family:'Fredoka',sans-serif;font-size:.6rem;letter-spacing:3px;color:var(--dim);margin-bottom:.5rem}
.r-code{font-family:'Fredoka',sans-serif;font-size:2.4rem;font-weight:700;line-height:1;color:var(--txt)}
.r-cn{font-size:1.4rem;font-weight:900;color:var(--txt);margin:.2rem 0 .4rem}
.r-cat{font-size:.72rem;letter-spacing:2px;padding:4px 12px;border-radius:20px;display:inline-block;font-weight:700;margin-bottom:.8rem}
.r-match{font-size:.85rem;color:var(--dim);margin-bottom:1rem}
.r-line{font-size:1rem;color:var(--txt2);font-style:italic;line-height:1.75;padding:0 .5rem}
.r-section{width:100%;margin-top:1.5rem}
.r-card{background:var(--card);border:1px solid var(--bdr);border-radius:16px;padding:1.2rem;margin-bottom:.8rem;box-shadow:0 2px 8px rgba(0,0,0,.03)}
.r-card h3{font-size:.8rem;letter-spacing:2px;margin-bottom:.7rem;display:flex;align-items:center;gap:6px;font-weight:900}
.r-card h3 i{width:8px;height:8px;border-radius:3px;display:inline-block}
.r-card p{font-size:.92rem;color:var(--txt2);line-height:1.9}
.r-radar{max-width:300px;margin:0 auto}
.r-radar canvas{width:100%;height:auto}
.r-legend{display:flex;justify-content:center;gap:.8rem;margin-top:.4rem;font-size:.68rem;color:var(--dim);flex-wrap:wrap}
.r-legend span{display:flex;align-items:center;gap:3px}
.r-legend b{width:8px;height:8px;border-radius:3px;display:inline-block}
.r-model{margin-bottom:.7rem}
.r-model-name{font-size:.78rem;font-weight:900;color:var(--txt);margin-bottom:.5rem;display:flex;align-items:center;gap:5px}
.r-model-name b{width:6px;height:6px;border-radius:2px}
.r-bar-row{display:flex;align-items:center;gap:5px;margin-bottom:.4rem;font-size:.72rem}
.r-bar-label{width:56px;text-align:right;color:var(--dim);flex-shrink:0}
.r-bar-track{flex:1;height:8px;background:#ece6e0;border-radius:4px;position:relative;overflow:hidden}
.r-bar-fill{position:absolute;top:0;height:100%;border-radius:4px;transition:width .6s ease}
.r-bar-mid{position:absolute;left:50%;top:0;width:1.5px;height:100%;background:rgba(0,0,0,.1)}
.r-bar-val{width:18px;text-align:left;color:var(--dim);font-weight:700}
.r-advice-card{background:linear-gradient(135deg,#fff5f0,#fff0f5);border:2px solid var(--accent);border-radius:16px;padding:1.2rem;margin-bottom:.8rem}
.r-advice-card h3{color:var(--accent)}
.r-advice-card p{color:var(--txt);font-weight:700;font-size:.95rem}
.r-footer{font-size:.7rem;color:var(--dim);line-height:1.7;text-align:center;margin-top:2rem}
.btn-retry{margin-top:1rem;font-size:.92rem;border-radius:50px}
.cat-self{color:#b07800;background:#fef3d0}.cat-bond{color:#1a7ab0;background:#daf0ff}.cat-mental{color:#c03030;background:#ffe0e0}.cat-style{color:#7040c0;background:#f0e8ff}.cat-hidden{color:#208050;background:#d8f5e8}
@keyframes shake{0%,100%{transform:translateX(0)}20%,60%{transform:translateX(-5px)}40%,80%{transform:translateX(5px)}}
</style>
</head>
<body>
<div class="screen intro active" id="introScreen">
  <div class="badge">NEW 峡谷版性格测试</div>
  <h1><span class="k">坑</span>BTI</h1>
  <div class="sub-en">Keng Based Type Indicator</div>
  <p class="pitch">MBTI测你是什么人。<br><b>KBTI测你在峡谷里有多坑。</b><br><br>36道题，4分钟。<br>不测操作，不测意识，不测段位。<br>测的是你打LOL时灵魂的形状。</p>
  <button class="btn" onclick="startQuiz()">开始鉴定</button>
  <div class="warn">* 纯属整活，与任何官方机构无关<br>* 测完觉得被冒犯了说明测准了</div>
  <div class="disclaimer">本项目由粉丝制作，与 Riot Games 无官方关联，所有角色形象及版权归属 Riot Games 所有。</div>
</div>
<div class="screen quiz" id="quizScreen">
  <div class="q-progress"><div class="q-bar-wrap"><div class="q-bar" id="qBar"></div></div><div class="q-info"><span id="qNum"></span><span id="qDone"></span></div></div>
  <div class="q-card" id="qCard"></div>
  <div class="q-nav"><button class="btn btn-prev" id="btnPrev" onclick="prevQ()">上一题</button><button class="btn btn-next" id="btnNext" onclick="nextQ()">下一题</button></div>
</div>
<div class="screen result" id="resultScreen"></div>
<script>

const IMG={"CARRY":"data:image/webp;base64,","1V9":"data:image/webp;base64,","JJG":"data:image/webp;base64,","FARM":"data:image/webp;base64,","GANK":"data:image/webp;base64,","WARD":"data:image/webp;base64,","SUPP":"data:image/webp;base64,","BB":"data:image/webp;base64,","TILT":"data:image/webp;base64,","GG":"data:image/webp;base64,","SMURF":"data:image/webp;base64,","FILL":"data:image/webp;base64,","ARAM":"data:image/webp;base64,","FEED":"data:image/webp;base64,","SKIN":"data:image/webp;base64,","REMAKE":"data:image/webp;base64,","SCRIPT":"data:image/webp;base64,","CLOUD":"data:image/webp;base64,"};

const DN={S1:'实力自评',S2:'段位焦虑',S3:'成长心态',E1:'抗压阈值',E2:'红温指数',E3:'胜负执念',A1:'风险偏好',A2:'决策速度',A3:'执行路径',T1:'指挥欲',T2:'容错心态',T3:'锅归何处',C1:'开麦意愿',C2:'嘴臭段位',C3:'社交粘度'};
const DIMS=Object.keys(DN);
const MODELS=[{n:'自我认知',d:['S1','S2','S3'],c:'#3b9cf0'},{n:'情绪管理',d:['E1','E2','E3'],c:'#f05050'},{n:'行为风格',d:['A1','A2','A3'],c:'#d4a020'},{n:'团队协作',d:['T1','T2','T3'],c:'#9060e0'},{n:'社交姿态',d:['C1','C2','C3'],c:'#30b070'}];

const QS=[
// S1 x3 (was 2, +1 new)
{t:"你和一个比你高两个段位的朋友双排，他说「这波你别上等我来」。你？",o:[{t:"听他的，他比我懂",s:{S1:1}},{t:"暗暗生闷气但还是配合",s:{S1:2}},{t:"管他的，我先上了再说",s:{S1:3}}]},
{t:"你朋友说要拉你打排位，你最近一直在玩大乱斗/下棋。你心里第一个想法是？",o:[{t:"可以啊，正好练练手",s:{S1:3}},{t:"排位是什么？LOL只有大乱斗/云顶",s:{S1:1}},{t:"无所谓",s:{S1:2}}]},
{t:"你朋友说你「适合打辅助」。你心里？",o:[{t:"他在侮辱我",s:{S1:3}},{t:"确实，我辅助打得还行",s:{S1:2}},{t:"我打什么都一样啦",s:{S1:1}}]},
// S2 x2
{t:"你已经两个星期没打开LOL了。今天突然打开，你第一个点的是？",o:[{t:"排位",s:{S2:3}},{t:"大乱斗",s:{S2:1}},{t:"先看看商城有没有皮肤",s:{S2:1}},{t:"云顶",s:{S2:1}}]},
{t:"赛季还剩3天，你差两把到晋级赛。今晚你要出门吃饭。你？",o:[{t:"先打",s:{S2:3}},{t:"先吃",s:{S2:2}},{t:"没人约我吃饭",s:{S2:1}}]},
// S3 x2
{t:"你用一个英雄打了很多场但胜率一直是38%。你会？",o:[{t:"继续打——有个说法叫量变引起质变！",s:{S3:1}},{t:"搜一下攻略深入学习一下",s:{S3:3}},{t:"不练了，肯定是英雄的问题啊",s:{S3:2}}]},
{t:"你朋友拉你看一场回放，里面你操作失误导致团灭。你会？",o:[{t:"「我的我的，哎我的」",s:{S3:3}},{t:"「不是我觉得没问题啊当时谁都会这么操作的你把鼠标键盘给Faker他也是这么玩」",s:{S3:1}},{t:"假装看，其实在发呆",s:{S3:2}}]},
// E1 x3 (+1 new)
{t:"你打上单，对面打野来了三次，你已经0/2了。你的打野一次都没来。你现在在做什么？",o:[{t:"在塔下苟住",s:{E1:3}},{t:"开始疯狂ping打野",s:{E1:1}},{t:"放弃对线了，一言不发去中路吃兵",s:{E1:2}}]},
{t:"你更喜欢哪种赢法？",o:[{t:"我carry全场队友躺赢",s:{E1:3}},{t:"大家一起团战打赢的",s:{E1:2}},{t:"对面自己犯错送的——怎么赢不重要",s:{E1:1}}]},
{t:"你打排位，选完英雄发现自己被对面阵容完克了。你？",o:[{t:"没关系，让我用实力说话",s:{E1:3}},{t:"深呼吸，想想怎么苟过对线期",s:{E1:2}},{t:"在想什么时候才能到下一把",s:{E1:1}}]},
// E2 x3 (+1 new)
{t:"你打ADC，辅助在你抢到的炮车上补了最后一刀。你？",o:[{t:"没什么，一个兵而已",s:{E2:1}},{t:"打一个信号提醒他",s:{E2:3}},{t:"心里不爽但什么都没说",s:{E2:2}}]},
{t:"你觉得LOL最近几个版本？",o:[{t:"越改越好玩了",s:{E2:1}},{t:"没感觉，向来不注意的",s:{E2:2}},{t:"设计师经典水多了加面面多了加水，又给他混一天工资，让我去干我也能干",s:{E2:3}}]},
{t:"你正在carry全场8/1，因为一个小失误被击杀了。你？",o:[{t:"笑一下，没事还是很肥",s:{E2:1}},{t:"骂了一句但很快调整了",s:{E2:2}},{t:"开始质疑队友为什么不帮我",s:{E2:3}}]},
// E3 x2
{t:"你上次因为LOL特别开心是因为？",o:[{t:"打了一波特别精彩的团战/操作",s:{E3:2}},{t:"和朋友一起赢了一把",s:{E3:1}},{t:"上了一个新段位",s:{E3:3}},{t:"抽到/买到了很喜欢的皮肤",s:{E3:1}}]},
{t:"你半夜一点钟，刚输了一把排位。你明天早上有事。你？",o:[{t:"再来一把——赢了才能睡",s:{E3:3}},{t:"关了——明天更重要",s:{E3:1}},{t:"打一把大乱斗缓一缓再说",s:{E3:2}}]},
// A1 x3 (+1 new)
{t:"刚刚的团战非常惨烈，你们全队都阵亡了，但对面也只剩一个满血的能守家。你？",o:[{t:"肯定直接上去莽啊，不能辜负队友",s:{A1:3}},{t:"当然还是等队友复活比较稳妥",s:{A1:1}},{t:"我是辅助耶...不关我事",s:{A1:2}}]},
{t:"你们经济落后5000，但你个人装备还行。一波团战的机会出现了。你？",o:[{t:"开——落后就该找机会拼，不然只会越拖越差",s:{A1:3}},{t:"苟——我是唯一的希望，万一输了不就炸了吗？",s:{A1:1}},{t:"让队友先开，我看情况跟进",s:{A1:2}}]},
{t:"你在河道看到落单的对面ADC，但你没有视野不知道其他人在哪。你？",o:[{t:"冲上去——一个ADC我还打不过？",s:{A1:3}},{t:"远远丢个技能试探一下再说",s:{A1:2}},{t:"当作没看见，该干嘛干嘛",s:{A1:1}}]},
// A2 x2
{t:"BP最后5秒你还在两个英雄之间犹豫。你？",o:[{t:"选当前鼠标停在的那个——来不及了",s:{A2:3}},{t:"选我更熟的那个",s:{A2:2}},{t:"实话说我经常在这个时候秒退过……",s:{A2:1}}]},
{t:"你队友在语音里喊「开龙开龙开龙」，你觉得现在打龙有点冒险。你？",o:[{t:"跟着打——他都喊了再犹豫就散了",s:{A2:3}},{t:"告诉他「等一下」然后看看地图",s:{A2:2}},{t:"赖着不去——我觉得不行就是不行",s:{A2:1}}]},
// A3 x2
{t:"你选英雄的时候一般先看什么？",o:[{t:"我们阵容还缺什么",s:{A3:2}},{t:"我想玩什么",s:{A3:1}},{t:"对面选了什么我好针对",s:{A3:3}},{t:"哪个皮肤我最近新买了",s:{A3:1}}]},
{t:"版本大更新了。你一般什么时候开始打游戏？",o:[{t:"更新当天就打——赶在别人研究明白之前",s:{A3:3}},{t:"等一两周看看大家都在玩什么",s:{A3:2}},{t:"跟以前一样打——版本改了跟我没太大关系",s:{A3:1}}]},
// T1 x2
{t:"五排开黑，对面在打大龙，你们队里没有人说话。你？",o:[{t:"我开麦喊：走大龙",s:{T1:3}},{t:"默默标信号然后往那边走，看队友跟不跟",s:{T1:2}},{t:"等别人先说——万一人家有别的想法",s:{T1:1}}]},
{t:"队友在做一个你觉得不太对的决定（比如逆风接正面团）。你会？",o:[{t:"疯狂打撤退试图打醒队友",s:{T1:3}},{t:"跟着打咯——反正不是我背锅",s:{T1:1}},{t:"我没什么存在感，这种问题不要问我",s:{T1:2}}]},
// T2 x3 (+1 new)
{t:"你的队友选了亚索，开局交了闪现拿到一血，然后后连送了两个。你在公屏会打什么？",o:[{t:"什么都不说",s:{T2:2}},{t:"「稳住兄弟，冷静能打的」",s:{T2:3}},{t:"追着他打问号",s:{T2:1}}]},
{t:"你的队友在前10分钟就0/4了，但他在公屏说「放心后期我能打」。你信吗？",o:[{t:"试试呗，反正我也没招了",s:{T2:2}},{t:"祈祷下把他排在你对面",s:{T2:1}},{t:"如果他玩的是后期英雄，我信",s:{T2:3}}]},
{t:"你朋友用了个从来没练过的英雄打排位，还说「我看攻略了没问题」。你？",o:[{t:"那就打呗，反正是你的号",s:{T2:1}},{t:"行吧，我帮你兜着",s:{T2:3}},{t:"你开心就好，我是无所谓",s:{T2:2}}]},
// T3 x2
{t:"刚才那波团战输了。你打开Tab看了一眼数据。你最先注意到的是？",o:[{t:"谁的伤害最低",s:{T3:1}},{t:"对面是哪个英雄carry的",s:{T3:2}},{t:"我自己那波操作有没有问题",s:{T3:3}}]},
{t:"你的打野抢了你的蓝buff。你？",o:[{t:"算了——他可能比我更需要",s:{T3:1}},{t:"质问他「那我缺的蓝谁给我补啊？」",s:{T3:2}},{t:"直接去对面偷一个",s:{T3:3}}]},
// C1 x2
{t:"你打排位遇到一个全程开麦指挥的路人。他的指挥大部分是对的。你？",o:[{t:"听着就行，省得自己操心",s:{C1:1}},{t:"跟他配合，偶尔说两句自己的看法",s:{C1:2}},{t:"有点烦——我有自己的节奏",s:{C1:3}}]},
{t:"你打LOL的时候身边一般是什么状态？",o:[{t:"朋友拉我打我才打",s:{C1:3}},{t:"一个人认真打",s:{C1:1}},{t:"一个人听着音乐/看着直播打",s:{C1:2}},{t:"上班的时候摸鱼打",s:{C1:1}}]},
// C2 x2
{t:"对面在公屏打了一个「?」。你？",o:[{t:"回他「？？？」",s:{C2:3}},{t:"记住他了——待会我必杀汝",s:{C2:2}},{t:"没看到/不在意",s:{C2:1}}]},
{t:"你队友开始在公屏和对面互相骂。你会？",o:[{t:"加入——帮队友骂",s:{C2:3}},{t:"说一句「别吵了打游戏」",s:{C2:2}},{t:"屏蔽公屏继续打自己的",s:{C2:1}}]},
// C3 x3 (+1 new)
{t:"一个你很久没联系的LOL好友突然上线了，你会？",o:[{t:"直接拉他一起玩",s:{C3:3}},{t:"先聊几句熟悉一下吧",s:{C3:2}},{t:"我没有朋友",s:{C3:1}}]},
{t:"你和一个路人排位配合得很好。打完之后你？",o:[{t:"主动加好友",s:{C3:3}},{t:"幻想对方会主动加我",s:{C3:2}},{t:"你在说什么啊，我已经在研究下一把的对手了",s:{C3:1}}]},
{t:"周末有人组了个五排车队喊你。你？",o:[{t:"光速加入！五排才是真正的LOL",s:{C3:3}},{t:"看看都有谁，再决定去不去",s:{C3:2}},{t:"不去...神总是孤独的...",s:{C3:1}}]},
];

const TP=[
{code:"CARRY",cn:"大爹",cat:"self",catN:"自我型",line:"什么都想扛，扛不动也硬上。",
game:"你是那个0/3还要打「稳住我carry」的人。队友让你别浪？听不见，耳朵里只有BGM。你打心底觉得这局成败系于你一身——赢了是大爹天降，输了是队友不配。",
real:"现实里你是什么都揽在身上的人：不是想揽活，是看着别人干你真坐不住。你嘴上嫌累，但让你袖手旁观你比谁都难受。",
good:"责任感爆表，关键时刻永远第一个站出来。你是团队里最可靠的兜底侠——哪怕自己已经0/5了，你的气场还在。",
bad:"你太累了。什么都自己扛的后果是：你永远觉得别人做得不够好。学会放手，也许队友没你想的那么菜。",
rel:"你最怕的队友类型是BB机——因为你受不了有人在你carry的时候指指点点。",
advice:"试着在下一局打一次辅助。不是因为你需要学会辅助，而是因为你需要学会——让别人carry。",
p:"HHH-HMH-HHM-HHM-MHM"},
{code:"1V9",cn:"独狼",cat:"self",catN:"自我型",line:"不是我不信队友，是上次信了直接掉大段。",
game:"永远单排。视野自己做龙自己偷。别人五排欢声笑语，你一个人默默上分。你不需要队友配合——你需要的只是队友别送。",
real:"能自己搞定的事绝不找人，不是社恐，是信不过别人的效率。你独处的时候效率最高。",
good:"你的独立性是最大的武器。在别人因为队友争吵分心的时候，你已经默默推掉了两座塔。",
bad:"你太孤了。有些局真的不是一个人能赢的。而且你永远不会有被人carry的快乐体验。",
rel:"你最好的搭档是那种不需要沟通也知道该干什么的人。你最怕全程开麦问「你在哪」的队友。",
advice:"下次试着接受一个朋友的双排邀请。偶尔被人carry一下，其实也挺爽的。",
p:"HHM-HLM-HHH-LLM-LLL"},
{code:"JJG",cn:"绝活王",cat:"self",catN:"自我型",line:"英雄池=1，封神或者去世。",
game:"你把一个英雄研究到了分子级。被ban了？选别的——然后以0/8完美证明「我只会这一个」。你的战绩页有一个英雄胜率70%，其他全是40%以下。",
real:"做自己热爱的事是天才，被迫做不喜欢的事就原地去世。你把所有努力都赌在了一个方向上。",
good:"在你的领域里你就是神。当你的本命英雄没被ban的时候，你是全场最不想遇到的对手。",
bad:"你的英雄池是你的天花板。一旦被针对，表现断崖式下跌。",
rel:"你需要的队友是愿意围绕你来组阵容的人。你给不了灵活性，但你给得了确定性。",
advice:"试着每个赛季认真练一个新英雄。不是为了加深英雄池，是为了提醒自己——你可以从零开始。",
p:"HHH-MHM-HHL-LLM-LML"},
{code:"FARM",cn:"刷子",cat:"self",catN:"自我型",line:"团战打完了他还在上路推线。",
game:"团战在河道天崩地裂，你在上路默默补兵。你永远是最后到场的人，但装备确实比谁都齐。",
real:"方案永远最稳，但机会窗口可能已经关了。你是大器晚成人设——问题是别人等不到那个时候。",
good:"你的耐心和纪律性是顶级的。在别人红温的时候，你还在稳稳执行自己的计划。",
bad:"你太稳了——稳到错过了该参与的时机。有些团战缺你一个真的打不赢。",
rel:"你和红温兰博是天然矛盾体——他觉得你该来你不来。但如果你俩磨合好，反而是最强组合。",
advice:"下一次团战响起来的时候，不管你差几个兵，先过去。你到场比你满装更重要。",
p:"MHM-LML-LMH-MMM-LMM"},
{code:"GANK",cn:"野王",cat:"bond",catN:"关系型",line:"三路都在叫救命，闲不住。",
game:"你打野不怎么刷野，因为三路都在喊「来一下」。你是全队参团率最高的人，但等级永远最低。",
real:"你是万能朋友——帮同事改方案、帮兄弟搬家。你活成了一个人形alert弹窗，哪里需要往哪弹。",
good:"你的团队意识是天生的。你能本能感觉到谁最需要帮助，然后出现在那里。",
bad:"你把所有精力花在别人身上，结果自己永远等级最低装备最差。不是所有人都值得你帮。",
rel:"你是所有人都想要的队友——但你最需要的是一个不需要你帮忙的搭档。",
advice:"下一局前6分钟不要gank任何一条路。把自己野区刷完。有时候「不帮忙」才是最大的帮忙。",
p:"MHM-HHM-MHM-HHH-HHM"},
{code:"WARD",cn:"真眼",cat:"bond",catN:"关系型",line:"做了一切但没人看见。",
game:"全场插了42个眼，控了三条龙，帮AD挡了致命技能——然后MVP给了那个站撸的金克丝。",
real:"你做的事永远不出现在周报里，但你一请假整个项目就停摆。你已经习惯了不被感谢。",
good:"你是团队的隐形支柱。你做的每一件事都不起眼，但每一件都不可或缺。",
bad:"你太习惯被忽视了。你的付出值得被看到——如果你不为自己发声，没人会替你说。",
rel:"你和大爹是最好的组合：你做脏活累活，他来carry全场。但你需要一个会说「辛苦了」的搭档。",
advice:"下次做了关键事情的时候，在公屏打一句话。不是邀功，是提醒自己：你做的事情有价值。",
p:"LMM-HMH-LMM-MHH-LMM"},
{code:"SUPP",cn:"奶妈",cat:"bond",catN:"关系型",line:"你的需求永远排在我前面。",
game:"你选辅助不是因为没人选——是你觉得看着AD carry起来比自己carry还舒服。没人在线你连游戏都不想开。",
real:"你是朋友圈里永远在问「你吃了吗」的人。但说真的有时候你也需要有人问你这句话。",
good:"你的共情能力是顶级的。你能在队友红温之前就感觉到他的情绪，然后用一句「稳住」拉回来。",
bad:"你太容易把别人的情绪当成自己的责任了。有时候，不是你的锅。",
rel:"你最好的搭档是一个会主动说「多亏了你」的人。你最怕把你付出当理所当然的人。",
advice:"下一局选一个可以carry的位置。让你体验一次——被别人保护的感觉。",
p:"MLM-HMH-LMM-MHH-HHH"},
{code:"BB",cn:"BB机",cat:"bond",catN:"关系型",line:"自己30补刀不妨碍教队友做人。",
game:"「应该先E再Q」「出这装干嘛」——你的嘴比手活跃十倍。你觉得在帮忙，别人觉得你是人形弹幕机。",
real:"同事做方案你能挑八个问题，让你自己做你说「没时间」。有趣的是你偶尔说的还真有道理。",
good:"你的信息整合能力和分析能力确实在线。你经常能看到队友看不到的问题。",
bad:"你的表达方式杀伤力太大。你需要学的不是「说什么」而是「怎么说」——以及「什么时候闭嘴」。",
rel:"你和红温兰博是天敌：你BB他就红温。你最好的搭档是菩萨——他不会被你的话影响。",
advice:"下一局把Enter键用胶布封起来。用你分析问题的脑子去打游戏——你会发现自己操作也没那么好。",
p:"HMM-MMH-MHM-HML-HHH"},
{code:"TILT",cn:"红温兰博",cat:"mental",catN:"心态型",line:"热量一过50%，所有技能变味。",
game:"你被Solo kill一次就方寸大乱。TP回线不是为了补兵，是为了报仇。你的脸跟兰博一样——热量一过50%所有技能都变味。",
real:"你之所以红温，是因为你不允许自己输得难看。你对自己要求比谁都高，只是表达方式是TP送。",
good:"你的胜负欲是你的燃料。状态好的时候你是全场最可怕的对手——你不仅想赢，还想赢得漂亮。",
bad:"你的情绪是你最大的敌人。逆风局里你的表现远不如真实水平——不是技术差了，是脑子被愤怒占满了。",
rel:"你需要一个情绪稳定的搭档。和菩萨组队最好——他的平静可以中和你的红温。",
advice:"被杀之后的10秒钟里，什么都不要做。就看着灰屏数到十。大多数报仇的冲动在10秒后就消失了。",
p:"HML-HHL-HHL-MLM-MHL"},
{code:"GG",cn:"菩萨",cat:"mental",catN:"心态型",line:"赢了不加寿，输了不扣命。",
game:"不管赢没赢你先打GG。队友骂你？发表情包。对面嘲讽？ctrl+6回一个。你是团队里唯一在微笑的人。",
real:"你心态稳如泰山——因为你早就悟了：这只是一局游戏。你不跟人起冲突不是冷漠，是真觉得没必要。",
good:"你是团队的镇静剂。在所有人红温的时候，你的一句「稳住」可以把整个团队心态拉回来。",
bad:"你太稳了——稳到有时候缺乏激情。在需要拼命的时候，你可能差了那么一口气。",
rel:"你是所有人都喜欢的队友——因为你永远不会给队伍添麻烦。但你也是最不容易被记住的。",
advice:"下一局遇到嚣张的对手试着让自己「在乎」一次。偶尔上头一下，反而能打出平时打不出的操作。",
p:"MML-LLL-LMM-MLM-MMM"},
{code:"SMURF",cn:"炸鱼仙人",cat:"mental",catN:"心态型",line:"不是不行，是怕输。",
game:"大号晋级赛就手抖，于是切到小号在白银局用亚索1V5找回人生意义。你不是打不上去，是不想面对掉段的恐惧。",
real:"真正重要的事总想拖一拖。你不是懒，你是怕输。你的口头禅是「等我状态好了再说」。",
good:"你其实很有实力——小号战绩就是证据。没有心理负担的时候你可以打得非常好。",
bad:"你在逃避。每一次切到小号，你都在告诉自己「先不面对了」——但大号的晋级赛永远在那里等着你。",
rel:"你需要一个不会在你输了后说「早知道就不打了」的搭档。最好的队友是那种说「没事再来一把」的人。",
advice:"把小号删了。就用大号打。输了就输了——掉段的痛苦远没有你想象中那么大。",
p:"MLL-MLH-MLM-LMM-MLM"},
{code:"FILL",cn:"工具人",cat:"style",catN:"风格型",line:"什么都能玩，说不清最想玩什么。",
game:"选位永远「补位」。缺什么你来什么。你的英雄胜率全在48%-52%之间——不出彩但不拉胯。",
real:"什么都还行，但被问到「你最擅长什么」你会卡壳三秒。你是百搭款——问题是百搭款永远不是限定款。",
good:"你是最好的队友模板。不管队伍需要什么你都能补上。你的灵活性让你在任何阵容里都不会成为短板。",
bad:"你太灵活了——灵活到可能已经忘了自己真正想要什么。如果一辈子都在补位，你什么时候做主角？",
rel:"你和任何人都能打配合——但和谁都不会特别合拍。你需要一个能帮你找到「你想玩什么」的搭档。",
advice:"下一次选位的时候，在「补位」出现之前先想三秒：你最想玩什么？然后选它。不管队伍缺不缺。",
p:"MML-MMM-MMM-MHM-MHM"},
{code:"ARAM",cn:"乱斗战神",cat:"style",catN:"风格型",line:"拒绝压力，快乐就完事了。",
game:"你大半年没碰排位了。你是乱斗里抢到炸弹人偷笑、抢到近战肉叹气但还是嘻嘻哈哈打完的那种人。",
real:"能用快乐解决的事绝不用焦虑碰。别人说你躺平，你说这叫「战略性快乐」。",
good:"你是团队的快乐源泉。当所有人为排位焦虑时，你是那个说「来两把大乱斗放松一下嘛」的人。",
bad:"你可能在用「快乐」来回避不想面对的东西。舒适区很舒服，但你确定想在里面待一辈子吗？",
rel:"你和所有人都能开心地打大乱斗——但很难找到愿意和你一起认真打排位的搭档。",
advice:"这个赛季认真打10局排位。就10局。你会发现：赢排位的快乐和赢大乱斗的快乐，味道不一样。",
p:"MLM-LMM-LLL-MML-HHH"},
{code:"FEED",cn:"下饭选手",cat:"style",catN:"风格型",line:"在努力了，但真的够不到。",
game:"0/7/2不是极限，是日常营业。你不是故意送，是真被打穿了还硬上——毕竟挂机会被举报。",
real:"别人骂你嘴上「无所谓」，其实偷偷截了战绩看三遍。你不是不努力，你是真的够不到。但你还在打——这本身就是一种勇气。",
good:"你有一种别人没有的东西：韧性。被打穿了还在上、被骂了还在打、连输十把还能打开客户端。",
bad:"你可能需要换一个方式努力了。同样的方法打一百局还是同样的结果，问题不在决心——在方法。",
rel:"你最需要的不是carry你的搭档——你需要的是一个在你0/5时还说「没事」的人。",
advice:"不要删游戏。你在做大多数人做不到的事：在不擅长的领域坚持。但试着找个朋友教你——自己死磕不如有人指路。",
p:"LLL-MLH-LLM-MLM-MMM"},
{code:"SKIN",cn:"皮肤狗",cat:"style",catN:"风格型",line:"死了没关系，死得要帅。",
game:"你选英雄的标准不是强度，是皮肤帅不帅。用至臻永恩0/5，但你觉得死的特效很好看。",
real:"你追求的不是赢，是「赢得好看」。你的桌面手机壳鼠标垫全统一配色。功能差不多的东西你一定选颜值高的。",
good:"你让这个游戏变得更好看了。你在意的东西——皮肤特效、英雄设计——是很多数据党忽略但很重要的部分。",
bad:"你可能太在意形式了。一个全特效皮肤的0/5永恩，终究还是0/5。",
rel:"你和其他皮肤狗一起打游戏最开心——不用忍受那些说「皮肤又不加攻击力」的人。",
advice:"下一局用默认皮肤打。你会发现：赢的感觉和皮肤无关。但赢了之后换上至臻补个截图——确实更帅。",
p:"MLM-MHM-MLM-MML-HMH"},
{code:"REMAKE",cn:"重开侠",cat:"style",catN:"风格型",line:"条件不完美就不想开始。",
game:"开局掉线→重开。BP不满意→想重开。被单杀→心里喊重开。条件不完美你提不起劲。",
real:"你在等一个完美时机，但那个时机可能永远不来。说到底你不是在等条件，你是在等一个「输了也不怪我」的理由。",
good:"你的品味和标准确实比大多数人高。你对「什么是一局好游戏」有清晰的判断。",
bad:"完美是行动的敌人。你等待的那个「万事俱备」的开局永远不会来。",
rel:"你和菩萨是好搭档：他不在乎开局怎么样，你在乎——你俩正好互补。",
advice:"下一次想点重开/投降的时候，多等5分钟。有些看起来注定失败的局，打着打着就活了。",
p:"HMH-MHM-LMH-HML-MLM"},
{code:"SCRIPT",cn:"代练号",cat:"hidden",catN:"隐藏",line:"花钱能解决的事为什么要自己打。",
game:"你不一定真找过代练，但你的思维方式就是「怎么花最少力气拿最多回报」。你的出装永远是胜率最高的那套。",
real:"考试靠技巧不靠复习，工作靠巧劲不靠死磕。你是效率的极端信徒，也是捷径的资深玩家。",
good:"你的效率思维是真的强。在别人还在死磕的时候你已经找到了最优解。",
bad:"捷径走多了你可能忘了怎么走正路。有些东西没有捷径——比如真正的技术提升。",
rel:"你是最不需要队友的人——但你也是最难建立真正友谊的人。",
advice:"下次遇到问题试着用最笨的方法去解决。你可能会发现：慢下来的过程里有些快不了的东西。",
p:"HHM-LML-HHH-LLM-MLM",hid:1},
{code:"CLOUD",cn:"云玩家",cat:"hidden",catN:"隐藏",line:"不玩，但比谁都懂。",
game:"你可能半年没打开客户端了，但LPL每场BP你都能点评、版本更新你发三条朋友圈、主播的梗你比粉丝还熟。",
real:"什么都关注什么都有想法，就是不动手。你享受「旁观者」这个角色带来的安全感。你是评论区之王。",
good:"你的信息获取和分析能力是顶级的。你可能比大多数玩家都更了解这个游戏的meta。",
bad:"你在用「懂」来代替「做」。知识不经过实践检验就只是段子素材。",
rel:"你和所有人都能聊LOL——但没人会叫你打排位。你在社交中是「知识输出者」不是「并肩作战的人」。",
advice:"打开客户端打一局排位。就一局。你会发现：你懂的远比你能做到的多——但只有做了，你的「懂」才不是纸上谈兵。",
p:"HHH-MHM-HMH-HHM-HMH",hid:1},
];

// Engine - 3-question dims use sum 3-9, 2-question dims use sum 2-6
const DIM_Q_COUNT={};
QS.forEach(q=>q.o.forEach(o=>{for(const d in o.s){DIM_Q_COUNT[d]=(DIM_Q_COUNT[d]||0)}}));
// Actually count properly
function countDimQuestions(){const c={};QS.forEach(q=>{const dims=new Set();q.o.forEach(o=>{for(const d in o.s)dims.add(d)});dims.forEach(d=>c[d]=(c[d]||0)+1)});return c}

const LV3=v=>v<=4?'L':v>=7?'H':'M'; // for 3-question dims (range 3-9)
const LV2=v=>v<=3?'L':v>=5?'H':'M'; // for 2-question dims (range 2-6)
const LN={L:1,M:2,H:3};

function calc(ans){
  const sm={};DIMS.forEach(d=>sm[d]=0);
  ans.forEach((oi,qi)=>{const s=QS[qi].o[oi].s;for(const d in s)sm[d]=(sm[d]||0)+s[d]});
  const qc=countDimQuestions();
  const levels={};
  DIMS.forEach(d=>{
    levels[d]=(qc[d]>=3?LV3:LV2)(sm[d]);
  });
  const uv=DIMS.map(d=>LN[levels[d]]);
  let best=null,bd=999,bh=0;
  TP.forEach(t=>{const tv=[];t.p.split('-').forEach(g=>[...g].forEach(c=>tv.push(LN[c])));let d=0,h=0;for(let i=0;i<15;i++){d+=Math.abs(uv[i]-tv[i]);if(uv[i]===tv[i])h++}if(d<bd||(d===bd&&h>bh)){best=t;bd=d;bh=h}});
  const maxD=15*2;
  return{type:best,match:Math.round((1-bd/maxD)*100),sums:sm};
}

function drawRadar(sm,cid){
  const c=document.getElementById(cid),ctx=c.getContext('2d');
  const W=560,cx=W/2,cy=W/2,R=190;c.width=W;c.height=W;ctx.clearRect(0,0,W,W);
  const qc=countDimQuestions();
  const vals=DIMS.map(d=>sm[d]/(qc[d]*3));
  const n=15,step=Math.PI*2/n;
  for(let ring=1;ring<=3;ring++){ctx.beginPath();for(let i=0;i<=n;i++){const a=-Math.PI/2+step*i,r=R*ring/3;ctx.lineTo(cx+r*Math.cos(a),cy+r*Math.sin(a))}ctx.closePath();ctx.strokeStyle='#e0d8d0';ctx.lineWidth=1;ctx.stroke()}
  for(let i=0;i<n;i++){const a=-Math.PI/2+step*i;ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(cx+R*Math.cos(a),cy+R*Math.sin(a));ctx.strokeStyle='#ece6e0';ctx.stroke()}
  const mc=['#3b9cf0','#3b9cf0','#3b9cf0','#f05050','#f05050','#f05050','#d4a020','#d4a020','#d4a020','#9060e0','#9060e0','#9060e0','#30b070','#30b070','#30b070'];
  ctx.beginPath();for(let i=0;i<=n;i++){const idx=i%n,a=-Math.PI/2+step*idx,r=R*Math.max(vals[idx],.08);ctx.lineTo(cx+r*Math.cos(a),cy+r*Math.sin(a))}ctx.closePath();ctx.fillStyle='rgba(255,107,64,.08)';ctx.fill();ctx.strokeStyle='rgba(255,107,64,.5)';ctx.lineWidth=2;ctx.stroke();
  for(let i=0;i<n;i++){const a=-Math.PI/2+step*i,r=R*Math.max(vals[i],.08);ctx.beginPath();ctx.arc(cx+r*Math.cos(a),cy+r*Math.sin(a),4,0,Math.PI*2);ctx.fillStyle=mc[i];ctx.fill();
  const lr=R+22,lx=cx+lr*Math.cos(a),ly=cy+lr*Math.sin(a);ctx.font='600 18px "Noto Sans SC"';ctx.fillStyle='#a09890';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(DN[DIMS[i]],lx,ly)}
}

let cur=0;const ans=new Array(QS.length).fill(-1);
function show(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active');window.scrollTo(0,0)}
function startQuiz(){cur=0;show('quizScreen');renderQ()}
function renderQ(){
  const q=QS[cur],total=QS.length;
  document.getElementById('qBar').style.width=((cur+1)/total*100)+'%';
  document.getElementById('qNum').textContent=`${cur+1} / ${total}`;
  document.getElementById('qDone').textContent=`已答 ${ans.filter(a=>a>=0).length}`;
  document.getElementById('qCard').innerHTML=`<div class="q-num">Q${cur+1}</div><div class="q-text">${q.t}</div><div class="q-opts">${q.o.map((o,i)=>`<div class="q-opt${ans[cur]===i?' sel':''}" onclick="pick(${i})"><div class="dot"></div><span>${o.t}</span></div>`).join('')}</div>`;
  document.getElementById('btnPrev').style.visibility=cur===0?'hidden':'visible';
  const nb=document.getElementById('btnNext');
  if(cur===total-1){nb.textContent='查看结果';nb.className='btn btn-submit'}else{nb.textContent='下一题';nb.className='btn btn-next'}
}
function pick(i){ans[cur]=i;document.querySelectorAll('.q-opt').forEach((el,j)=>el.classList.toggle('sel',j===i));if(cur<QS.length-1)setTimeout(()=>{cur++;renderQ()},250)}
function nextQ(){
  if(ans[cur]<0){const c=document.getElementById('qCard');c.style.animation='none';void c.offsetHeight;c.style.animation='shake .3s';return}
  if(cur>=QS.length-1){if(ans.some(a=>a<0)){alert(`还有 ${ans.filter(a=>a<0).length} 题没答`);cur=ans.indexOf(-1);renderQ();return}showResult();return}
  cur++;renderQ();
}
function prevQ(){if(cur>0){cur--;renderQ()}}
function showResult(){
  const r=calc(ans),t=r.type;
  const cc={self:'cat-self',bond:'cat-bond',mental:'cat-mental',style:'cat-style',hidden:'cat-hidden'};
  const imgSrc=IMG[t.code]||'';
  const qc=countDimQuestions();
  const el=document.getElementById('resultScreen');
  el.innerHTML=`
  <div class="r-hero">
    <div class="r-img">${imgSrc?`<img src="${imgSrc}" alt="${t.cn}">`:'?'}</div>
    <div class="r-logo2">KBTI · 坑BTI</div>
    <div class="r-code">${t.code}</div>
    <div class="r-cn">${t.cn}</div>
    <div class="r-cat ${cc[t.cat]||''}">${t.catN}</div>
    <div class="r-match">匹配度 ${r.match}%</div>
    <div class="r-line">「${t.line}」</div>
  </div>
  <div class="r-section">
    <div class="r-card"><h3>五维雷达图</h3>
      <div class="r-radar"><canvas id="rc" width="560" height="560"></canvas>
      <div class="r-legend"><span><b style="background:#3b9cf0"></b>自我</span><span><b style="background:#f05050"></b>情绪</span><span><b style="background:#d4a020"></b>行动</span><span><b style="background:#9060e0"></b>团队</span><span><b style="background:#30b070"></b>社交</span></div></div>
    </div>
    <div class="r-card"><h3>五大模型详情</h3><div id="rB"></div></div>
  </div>
  <div class="r-section">
    <div class="r-card"><h3><i style="background:#f05050"></i>你在峡谷里</h3><p>${t.game}</p></div>
    <div class="r-card"><h3><i style="background:#3b9cf0"></i>你在现实中</h3><p>${t.real}</p></div>
    <div class="r-card"><h3><i style="background:#30b070"></i>你的优势</h3><p>${t.good}</p></div>
    <div class="r-card"><h3><i style="background:#e060a0"></i>你的软肋</h3><p>${t.bad}</p></div>
    <div class="r-card"><h3><i style="background:#9060e0"></i>你和队友</h3><p>${t.rel}</p></div>
    <div class="r-advice-card"><h3><i style="background:#ff6b40"></i>给你的一句话</h3><p>${t.advice}</p></div>
  </div>
  <div class="r-footer">KBTI · Keng Based Type Indicator<br>纯属整活 · 测完觉得被冒犯了说明测准了<br><span class="r-disclaimer">本项目由粉丝制作，与 Riot Games 无官方关联，所有角色形象及版权归属 Riot Games 所有。</span></div>
  <button class="btn btn-retry" onclick="location.reload()">再测一次</button>`;
  show('resultScreen');
  setTimeout(()=>{
    drawRadar(r.sums,'rc');
    let bh='';
    MODELS.forEach(m=>{bh+=`<div class="r-model"><div class="r-model-name"><b style="background:${m.c}"></b>${m.n}</div>`;
    m.d.forEach(d=>{const v=r.sums[d],maxV=qc[d]*3,pct=Math.round(v/maxV*100),isH=v>maxV/2;
    bh+=`<div class="r-bar-row"><div class="r-bar-label">${DN[d]}</div><div class="r-bar-track"><div class="r-bar-mid"></div><div class="r-bar-fill" style="width:${Math.abs(pct-50)}%;${isH?'left:50%':'right:50%'};background:${m.c};opacity:.65"></div></div><div class="r-bar-val">${v}</div></div>`});
    bh+=`</div>`;});
    document.getElementById('rB').innerHTML=bh;
    setTimeout(()=>{document.querySelectorAll('.r-bar-fill').forEach(el=>{const w=el.style.width;el.style.width='0';requestAnimationFrame(()=>el.style.width=w)})},100);
  },200);
}


</script>
</body>
</html>
